// Prisma Schema — Interview Coach Platform
// Phase 10 — Step 4: User Profile
// Phase 11 — Razorpay Subscription System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────────────────────
model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String
  isVerified           Boolean        @default(false)
  emailVerifiedAt      DateTime?      // null = unverified; timestamp = when verified
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  lastLoginAt          DateTime?
  profile              UserProfile?
  refreshTokens        RefreshToken[]
  interviewSessions    InterviewSession[]
  passwordResetTokens  PasswordResetToken[]
  passwordResetOtps    PasswordResetOtp[]
  emailVerificationOtps EmailVerificationOtp[]
  subscriptions        Subscription[]
  entitlements         Entitlement[]
  paymentTransactions  PaymentTransaction[]

  @@map("users")
}

// ── UserProfile ───────────────────────────────────────────────────────────────
model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  fullName        String?
  phone           String?
  targetRole      String?
  experienceYears Float?
  bio             String?
  // Extended profile fields (added for unified single-source-of-truth profile)
  skills          String[] @default([])
  education       Json     @default("[]")
  projects        Json     @default("[]")
  certifications  Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ── RefreshToken ──────────────────────────────────────────────────────────────
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ── PasswordResetToken ────────────────────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── PasswordResetOtp ──────────────────────────────────────────────────────────
model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  email      String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("password_reset_otps")
}

// ── InterviewSession ──────────────────────────────────────────────────────────
model InterviewSession {
  id            String   @id @default(uuid())
  userId        String
  role          String
  type          String
  difficulty    String
  questionCount Int
  score         Int      // 0–100
  hiringBand    String
  summary       String   @db.Text
  strengths     String[]
  areasToImprove String[]
  skillScores   Json     @default("{}") // e.g. {"Technical Knowledge": 88}
  durationSecs  Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("interview_sessions")
}

// ── InterviewQuestion ─────────────────────────────────────────────────────────
model InterviewQuestion {
  id              String   @id @default(uuid())
  interviewId     String
  questionNumber  Int

  question        String   @db.Text
  candidateAnswer String   @db.Text
  expectedAnswer  String   @db.Text
  feedback        String   @db.Text
  score           Int

  topic           String?
  type            String?

  createdAt       DateTime @default(now())

  interview InterviewSession @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@unique([interviewId, questionNumber])
  @@map("interview_questions")
}

// ── EmailVerificationOtp ──────────────────────────────────────────────────────
model EmailVerificationOtp {
  id           String    @id @default(uuid())
  userId       String?
  email        String
  otpHash      String
  passwordHash String?   // Stored temporarily for pending registration
  fullName     String?   // Stored temporarily for pending registration
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("email_verification_otps")
}


// ══════════════════════════════════════════════════════════════════════════════
// SUBSCRIPTION / PAYMENT MODELS
// ══════════════════════════════════════════════════════════════════════════════

// ── Enums ─────────────────────────────────────────────────────────────────────

enum PaymentProvider {
  RAZORPAY
}

enum SubscriptionStatus {
  CREATED          // Created locally, awaiting Razorpay checkout
  AUTHENTICATED    // Customer has authorised the mandate; payment pending
  ACTIVE           // Successfully charged and active
  PAYMENT_PENDING  // Scheduled charge pending (between cycles)
  HALTED           // Razorpay has halted due to repeated charge failures
  CANCELLED        // Cancelled (by user or admin)
  COMPLETED        // Natural end of subscription (all cycles exhausted)
  EXPIRED          // Local expiry after period end
}

enum EntitlementStatus {
  ACTIVE
  INACTIVE
  GRACE            // Within grace window after payment issue
}

enum TransactionStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// ── Plan ──────────────────────────────────────────────────────────────────────
// Plans are configured on the backend (not in Flutter).
// Razorpay Plan IDs come from the backend env — never from Flutter.
model Plan {
  id                String          @id @default(uuid())
  name              String          // e.g. "Premium Monthly"
  code              String          @unique // e.g. "PREMIUM_MONTHLY"
  description       String          @default("")
  priceInPaise      Int             // Amount in smallest currency unit (paise)
  currency          String          @default("INR")
  billingInterval   BillingInterval
  razorpayPlanId    String?         // From Razorpay Dashboard (or env)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  subscriptions     Subscription[]

  @@map("plans")
}

// ── Subscription ──────────────────────────────────────────────────────────────
model Subscription {
  id                      String             @id @default(uuid())
  userId                  String
  planId                  String
  provider                PaymentProvider    @default(RAZORPAY)
  providerSubscriptionId  String?            @unique // Razorpay subscription_id
  status                  SubscriptionStatus @default(CREATED)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  startedAt               DateTime?
  cancelledAt             DateTime?
  endedAt                 DateTime?
  autoRenew               Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan                 @relation(fields: [planId], references: [id])
  paymentTransactions  PaymentTransaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([providerSubscriptionId])
  @@map("subscriptions")
}

// ── PaymentTransaction ────────────────────────────────────────────────────────
model PaymentTransaction {
  id                  String            @id @default(uuid())
  userId              String
  subscriptionId      String?
  provider            PaymentProvider   @default(RAZORPAY)
  providerPaymentId   String?           @unique // Razorpay payment_id
  providerOrderId     String?           // Razorpay order_id (if present)
  amount              Int               // In smallest currency unit (paise)
  currency            String            @default("INR")
  status              TransactionStatus @default(PENDING)
  paidAt              DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([providerPaymentId])
  @@map("payment_transactions")
}

// ── Entitlement ───────────────────────────────────────────────────────────────
// Single source of truth for feature access.
// The rest of the app queries entitlements, not subscription status directly.
model Entitlement {
  id           String            @id @default(uuid())
  userId       String
  feature      String            @default("PREMIUM") // e.g. "PREMIUM"
  status       EntitlementStatus @default(INACTIVE)
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
  @@map("entitlements")
}

// ── WebhookEvent ──────────────────────────────────────────────────────────────
// Persists each processed webhook event for idempotency.
// Prevents duplicate webhook processing for the same event.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    PaymentProvider @default(RAZORPAY)
  eventId     String   @unique // Razorpay event ID (or our own composite key)
  eventType   String   // e.g. "subscription.activated"
  payload     Json     // Full webhook payload (sanitised)
  processedAt DateTime @default(now())

  @@index([eventId])
  @@map("webhook_events")
}
