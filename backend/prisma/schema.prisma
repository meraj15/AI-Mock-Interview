// Prisma Schema — Interview Coach Platform
// Phase 10 — Step 4: User Profile
// Phase 11 — Razorpay Subscription System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ──────────────────────────────────────────────────────────────────────
model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String
  isVerified           Boolean        @default(false)
  emailVerifiedAt      DateTime?      // null = unverified; timestamp = when verified
  isActive             Boolean        @default(true)
  isAdmin              Boolean        @default(false)
  role                 String         @default("USER") // "USER" | "ADMIN"
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  lastLoginAt          DateTime?
  profile              UserProfile?
  refreshTokens        RefreshToken[]
  interviewSessions    InterviewSession[]
  passwordResetTokens  PasswordResetToken[]
  passwordResetOtps    PasswordResetOtp[]
  emailVerificationOtps EmailVerificationOtp[]
  subscriptions        Subscription[]
  entitlements         Entitlement[]
  paymentTransactions  PaymentTransaction[]
  usageQuotas          UserUsageQuota[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ── UserProfile ───────────────────────────────────────────────────────────────
model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  fullName        String?
  phone           String?
  targetRole      String?
  experienceYears Float?
  bio             String?
  // Extended profile fields (added for unified single-source-of-truth profile)
  skills          String[] @default([])
  education       Json     @default("[]")
  projects        Json     @default("[]")
  certifications  Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ── RefreshToken ──────────────────────────────────────────────────────────────
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ── PasswordResetToken ────────────────────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── PasswordResetOtp ──────────────────────────────────────────────────────────
model PasswordResetOtp {
  id         String    @id @default(uuid())
  userId     String
  email      String
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("password_reset_otps")
}

// ── InterviewSession ──────────────────────────────────────────────────────────
model InterviewSession {
  id            String   @id @default(uuid())
  userId        String
  role          String
  type          String
  difficulty    String
  questionCount Int
  score         Int      // 0–100
  hiringBand    String
  summary       String   @db.Text
  strengths     String[]
  areasToImprove String[]
  skillScores   Json     @default("{}") // e.g. {"Technical Knowledge": 88}
  durationSecs  Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("interview_sessions")
}

// ── InterviewQuestion ─────────────────────────────────────────────────────────
model InterviewQuestion {
  id              String   @id @default(uuid())
  interviewId     String
  questionNumber  Int

  question        String   @db.Text
  candidateAnswer String   @db.Text
  expectedAnswer  String   @db.Text
  feedback        String   @db.Text
  score           Int

  topic           String?
  type            String?

  createdAt       DateTime @default(now())

  interview InterviewSession @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@unique([interviewId, questionNumber])
  @@map("interview_questions")
}

// ── EmailVerificationOtp ──────────────────────────────────────────────────────
model EmailVerificationOtp {
  id           String    @id @default(uuid())
  userId       String?
  email        String
  otpHash      String
  passwordHash String?   // Stored temporarily for pending registration
  fullName     String?   // Stored temporarily for pending registration
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("email_verification_otps")
}


// ══════════════════════════════════════════════════════════════════════════════
// SUBSCRIPTION / PAYMENT MODELS
// ══════════════════════════════════════════════════════════════════════════════

// ── Enums ─────────────────────────────────────────────────────────────────────

enum PaymentProvider {
  RAZORPAY
}

enum SubscriptionStatus {
  CREATED          // Created locally, awaiting Razorpay checkout
  AUTHENTICATED    // Customer has authorised the mandate; payment pending
  ACTIVE           // Successfully charged and active
  PAYMENT_PENDING  // Scheduled charge pending (between cycles)
  HALTED           // Razorpay has halted due to repeated charge failures
  CANCELLED        // Cancelled (by user or admin)
  COMPLETED        // Natural end of subscription (all cycles exhausted)
  EXPIRED          // Local expiry after period end
}

enum EntitlementStatus {
  ACTIVE
  INACTIVE
  GRACE            // Within grace window after payment issue
}

enum TransactionStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// ── Plan ──────────────────────────────────────────────────────────────────────
// Plans are configured on the backend (not in Flutter).
// Razorpay Plan IDs come from the backend env — never from Flutter.
model Plan {
  id                String          @id @default(uuid())
  name              String          // e.g. "Premium Monthly"
  code              String          @unique // e.g. "PREMIUM_MONTHLY"
  description       String          @default("")
  priceInPaise      Int             // Amount in smallest currency unit (paise)
  currency          String          @default("INR")
  tier              String          @default("PRO") // "FREE" | "PRO"
  billingInterval   BillingInterval
  razorpayPlanId    String?         // From Razorpay Dashboard (or env)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  subscriptions     Subscription[]

  @@map("plans")
}

// ── Subscription ──────────────────────────────────────────────────────────────
model Subscription {
  id                      String             @id @default(uuid())
  userId                  String
  planId                  String
  provider                PaymentProvider    @default(RAZORPAY)
  providerSubscriptionId  String?            @unique // Razorpay subscription_id
  status                  SubscriptionStatus @default(CREATED)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  startedAt               DateTime?
  cancelledAt             DateTime?
  endedAt                 DateTime?
  autoRenew               Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan                 @relation(fields: [planId], references: [id])
  paymentTransactions  PaymentTransaction[]

  @@index([userId])
  @@index([userId, status])
  @@index([providerSubscriptionId])
  @@map("subscriptions")
}

// ── PaymentTransaction ────────────────────────────────────────────────────────
model PaymentTransaction {
  id                  String            @id @default(uuid())
  userId              String
  subscriptionId      String?
  provider            PaymentProvider   @default(RAZORPAY)
  providerPaymentId   String?           @unique // Razorpay payment_id
  providerOrderId     String?           // Razorpay order_id (if present)
  amount              Int               // In smallest currency unit (paise)
  currency            String            @default("INR")
  status              TransactionStatus @default(PENDING)
  paidAt              DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([providerPaymentId])
  @@map("payment_transactions")
}

// ── Entitlement ───────────────────────────────────────────────────────────────
// Single source of truth for feature access.
// The rest of the app queries entitlements, not subscription status directly.
model Entitlement {
  id           String            @id @default(uuid())
  userId       String
  feature      String            @default("PREMIUM") // e.g. "PREMIUM"
  status       EntitlementStatus @default(INACTIVE)
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
  @@map("entitlements")
}

// ── WebhookEvent ──────────────────────────────────────────────────────────────
// Persists each processed webhook event for idempotency.
// Prevents duplicate webhook processing for the same event.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    PaymentProvider @default(RAZORPAY)
  eventId     String   @unique // Razorpay event ID (or our own composite key)
  eventType   String   // e.g. "subscription.activated"
  payload     Json     // Full webhook payload (sanitised)
  processedAt DateTime @default(now())

  @@index([eventId])
  @@map("webhook_events")
}

// ── UserUsageQuota ────────────────────────────────────────────────────────────
// Tracks monthly or billing-period usage counters (interviews, resume scans, voice).
// Quota corresponds to billing cycle for paid subscriptions, calendar month for Free.
model UserUsageQuota {
  id               String   @id @default(uuid())
  userId           String
  periodKey        String   // e.g. "free_2026-09" or "sub_<subId>_<startMs>"
  interviewsUsed   Int      @default(0)
  resumeScansUsed  Int      @default(0)
  voiceSecondsUsed Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@index([userId])
  @@map("user_usage_quotas")
}

// ══════════════════════════════════════════════════════════════════════════════
// ADMIN & OBSERVABILITY MODELS
// ══════════════════════════════════════════════════════════════════════════════

// ── AuditLog ──────────────────────────────────────────────────────────────────
// Tracks administrative and privileged operations for accountability and security.
model AuditLog {
  id            String   @id @default(uuid())
  adminId       String
  action        String   // e.g. "USER_SUSPEND", "ENTITLEMENT_GRANT", "PLAN_UPDATE"
  targetType    String   // "USER", "SUBSCRIPTION", "PLAN", "SYSTEM"
  targetId      String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── AiTelemetryLog ────────────────────────────────────────────────────────────
// Stores detailed AI latency, token usage, errors, and costs for admin observability.
model AiTelemetryLog {
  id             String   @id @default(uuid())
  sessionId      String?
  userId         String?
  operation      String   // 'plan' | 'live_turn' | 'final_evaluation' | 'resume_parsing'
  provider       String   // 'gemini' | 'openai'
  model          String
  latencyMs      Int
  promptBuildMs  Int?
  aiLatencyMs    Int?
  parseMs        Int?
  dbMs           Int?
  totalLatencyMs Int?
  attemptCount   Int      @default(1)
  retryCount     Int      @default(0)
  retryReason    String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  status         Int      @default(200) // 200, 429, 503, 504, 500
  errorCategory  String?  // 'RATE_LIMIT' | 'SERVICE_UNAVAILABLE' | 'TIMEOUT' | 'JSON_PARSE' | 'AUTH' | 'OTHER'
  errorMessage   String?  // Sanitized error message (no secrets/PII)
  degraded       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([operation])
  @@index([provider])
  @@index([createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@map("ai_telemetry_logs")
}

// ── ResumeParseLog ────────────────────────────────────────────────────────────
// Stores analytics for resume parsing requests, failures, and file metadata.
model ResumeParseLog {
  id          String   @id @default(uuid())
  userId      String?
  fileName    String
  fileSize    Int
  status      String   // 'SUCCESS' | 'FAILED'
  errorReason String?  // 'EMPTY_TEXT' | 'AI_FAILURE' | 'FILE_TOO_LARGE' | 'TIMEOUT'
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("resume_parse_logs")
}

// ── SystemConfig ──────────────────────────────────────────────────────────────
// Stores dynamic administrative configurations such as quotas, pricing, and toggles.
model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

