# Server
PORT=3000
NODE_ENV=production

# CORS (Comma-separated allowed origins for Admin CMS / Web in production)
CORS_ORIGIN=https://admin.yourdomain.com

# PostgreSQL Database
DATABASE_URL=

# JWT Secrets (Minimum 32 characters each — required in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Brevo SMTP Configuration (Email & Password Reset OTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Mock Interview

# AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# AI Architecture & Model Routing
AI_LIVE_PRIMARY_PROVIDER=gemini
AI_LIVE_PRIMARY_MODEL=gemini-3.7-flash
AI_LIVE_FALLBACK_PROVIDER=openai
AI_LIVE_FALLBACK_MODEL=gpt-4o-mini

AI_EVAL_PRIMARY_PROVIDER=gemini
AI_EVAL_PRIMARY_MODEL=gemini-3.7-flash
AI_EVAL_FALLBACK_PROVIDER=openai
AI_EVAL_FALLBACK_MODEL=gpt-4o

AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=30000
AI_LIVE_TIMEOUT_MS=15000
AI_EVAL_TIMEOUT_MS=60000

# ── Razorpay Payment ───────────────────────────────────────────────────────────
# Key ID is public — used by Flutter checkout. Use rzp_test_... for test mode.
RAZORPAY_KEY_ID=
# NEVER commit or log the following secrets.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay Plan IDs — create these in Razorpay Dashboard → Subscriptions → Plans.
RAZORPAY_MONTHLY_PLAN_ID=
RAZORPAY_YEARLY_PLAN_ID=