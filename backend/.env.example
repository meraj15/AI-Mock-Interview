# Server
PORT=3000
NODE_ENV=production

# PostgreSQL Database
DATABASE_URL=

# JWT Secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# AI Architecture & Model Routing
AI_LIVE_PRIMARY_PROVIDER=gemini
AI_LIVE_PRIMARY_MODEL=gemini-3.8-flash
AI_LIVE_FALLBACK_PROVIDER=openai
AI_LIVE_FALLBACK_MODEL=gpt-4o-mini

AI_EVAL_PRIMARY_PROVIDER=gemini
AI_EVAL_PRIMARY_MODEL=gemini-3.8-flash
AI_EVAL_FALLBACK_PROVIDER=openai
AI_EVAL_FALLBACK_MODEL=gpt-4o

AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=30000
AI_LIVE_TIMEOUT_MS=8000
AI_EVAL_TIMEOUT_MS=60000