# Required environment variables for the AI Interview Coach API
# Copy this file to .env and fill in the values

# Server
PORT=
NODE_ENV=

# PostgreSQL Database (Prisma connection string)
DATABASE_URL=

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
